{
  "imports": {
    "@oak/oak": "jsr:@oak/oak@^17.2.0",
    "@tajpouria/cors": "jsr:@tajpouria/cors@^1.2.1"
  },
  "tasks": {
    "build": "VITE_IS_PROD=true deno run -A npm:vite build",
    "client:dev": "deno run -A npm:vite",
    "server:dev": "deno run -A --env-file --watch ./server/main.ts",
    "server:start": "deno run -A --env-file ./server/main.ts"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "types": [
      "react",
      "react-dom",
      "@types/react"
    ],
    "lib": [
      "dom",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}